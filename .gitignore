.build/
.swiftpm/
*.xcodeproj/
# The iPhone app's project is checked in (see iOS/project.yml); per-user Xcode state isn't.
!iOS/LaunchpadPhone.xcodeproj/
xcuserdata/
DerivedData/
dist/
.DS_Store
# Launchpad's own data, when the app's home folder is this checkout (~/Launchpad and ~/launchpad are the same
# folder on a case-insensitive disk). Chats, bots and connector settings must never be committed.
/.launchpad/
/Shared/
/bots/
/chats/
/groups/
/skills/
/work/
/connectors.json
